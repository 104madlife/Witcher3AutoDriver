# Copy this file to .mod-project.local.ps1 and edit the local paths.
# The local file is intentionally ignored by Git.
$Witcher3AutoDriverGameRoot = "<replace-with-the-game-root-containing-bin-mods-and-dlc>"
$Witcher3AutoDriverUserInputPath = Join-Path ([Environment]::GetFolderPath("MyDocuments")) "The Witcher 3\input.settings"
